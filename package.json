{
  "name": "dsh-workspace-keeper",
  "version": "0.2.0",
  "description": "让 AI 别再乱放文件：落盘前按登记表校验位置，工具分公共/项目并支持历史归档。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "workspace",
    "layout",
    "guardrail"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baiyue23333/dsh-workspace-keeper.git"
  },
  "homepage": "https://github.com/baiyue23333/dsh-workspace-keeper#readme",
  "bugs": {
    "url": "https://github.com/baiyue23333/dsh-workspace-keeper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
